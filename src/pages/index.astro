---
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteHeader from "../components/layout/SiteHeader.astro";
import SiteFooter from "../components/layout/SiteFooter.astro";
import Container from "../components/shared/Container.astro";
import SectionHeading from "../components/shared/SectionHeading.astro";
import ScorecardTable from "../components/scorecards/ScorecardTable.astro";
import DepartmentTile from "../components/departments/DepartmentTile.astro";
import VisibilityGrid from "../components/visibility/VisibilityGrid.astro";
import TestLog from "../components/test-log/TestLog.astro";
import MethodPreview from "../components/editorial/MethodPreview.astro";
import WorkWithMeTeaser from "../components/editorial/WorkWithMeTeaser.astro";
import HomeDisclosures from "../components/disclosures/HomeDisclosures.astro";
import { siteConfig } from "../lib/site";
import { departments } from "../lib/content/departments";
import { featuredScorecard } from "../lib/content/scorecards";
import { latestSnapshot } from "../lib/content/visibility";
import { testLog } from "../lib/content/testLog";

const title = "Independent tests of the tools SaaS founders use to grow. — EKIS";
const description = "Same tasks, same sample data, scored and dated. Independent SaaS growth publication testing AI Search Visibility software.";
---

<BaseLayout title={title} description={description}>
  <SiteHeader logoText={siteConfig.brand.name} navigationItems={[...siteConfig.nav]} />

  <main id="main">
    <!-- 1 — Hero + Featured scorecard -->
    <section class="section border-b" style="border-color: var(--color-border)">
      <Container>
        <div class="grid items-start gap-10 lg:grid-cols-[1.05fr_0.95fr]">
          <div>
            <p class="eyebrow">Independent software research — M2</p>
            <h1 class="page-title mt-3" style="font-size: var(--text-hero);">Independent tests of the tools SaaS founders use to grow.</h1>
            <p class="mt-4 max-w-prose text-[1.05rem] leading-relaxed text-[var(--color-muted)]">Same tasks, same sample data, scored and dated. AI Search Visibility first. Every claim linked to dated evidence.</p>
            <div class="mt-6 flex flex-wrap gap-3">
              <a href="/scorecards" class="btn btn-primary">See the latest scorecard</a>
              <a href="/method" class="btn btn-secondary">How we test</a>
            </div>
            <p class="meta mt-3">No invented scores. Featured table is a prototype until first test is published — verdicts show Pending with test date “—”.</p>
          </div>

          <div id="featured-scorecard">
            <ScorecardTable
              products={featuredScorecard.products}
              tasks={featuredScorecard.tasks}
              testDate={featuredScorecard.testDate}
              status={featuredScorecard.status}
              evidenceHref={featuredScorecard.evidenceHref}
              disclosure={featuredScorecard.disclosure}
            />
          </div>
        </div>
      </Container>
    </section>

    <!-- 2 — Browse by job: six department tiles -->
    <section class="section" aria-labelledby="departments-heading" id="departments">
      <Container>
        <SectionHeading
          eyebrow="Browse by job"
          title="Start from the job you’re hiring software to do"
          description="Six departments. AI Search Visibility is active first. Others are future research areas — no fabricated counts. Published research shows “—” until first test is complete."
        />
        <h2 id="departments-heading" class="sr-only">Departments</h2>
        <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {departments.map((d) => (
            <DepartmentTile
              number={d.number}
              title={d.title}
              description={d.description}
              href={d.href}
              publishedCount={d.publishedCount}
              status={d.status}
            />
          ))}
        </div>
      </Container>
    </section>

    <!-- 3 — AI Visibility Snapshot -->
    <section class="section" aria-labelledby="visibility-heading" id="ai-visibility">
      <Container>
        <div class="flex flex-wrap items-baseline justify-between gap-3">
          <p class="eyebrow">AI Search Visibility · snapshot</p>
          <a href="/method" class="meta link">Mention ≠ citation · How we measure →</a>
        </div>
        <h2 id="visibility-heading" class="sr-only">AI Visibility Snapshot</h2>
        <div class="mt-4">
          <VisibilityGrid
            prompts={latestSnapshot.prompts}
            platforms={latestSnapshot.platforms as any}
            rows={latestSnapshot.rows as any}
            testDate={latestSnapshot.testDate}
            testedBrand={latestSnapshot.testedBrand}
            evidenceHref={latestSnapshot.evidenceHref}
            limitations={latestSnapshot.limitations}
          />
        </div>
        <p class="meta mt-3">12 prompts × 3 platforms. Each cell shows Y (Mentioned), N (Not mentioned), C (Citation) or U (Unable). Dated test label and link to full record added when published.</p>
      </Container>
    </section>

    <!-- 4 — Dated test log -->
    <section class="section border-y" style="border-color: var(--color-border); background: var(--color-surface)" aria-labelledby="testlog-heading" id="test-log">
      <Container>
        <SectionHeading
          eyebrow="Evidence"
          title="Dated test log"
          description="Every test is dated. Statuses: Planned, In progress, Completed — the last only when checked and ready for publication. No completed research is claimed yet."
        />
        <h2 id="testlog-heading" class="sr-only">Dated test log</h2>
        <div class="mt-6">
          <TestLog entries={testLog as any} />
        </div>
        <p class="meta mt-3">Planned and In progress entries show what is queued. A row becomes Completed only when evidence is published.</p>
      </Container>
    </section>

    <!-- 5 — Method preview -->
    <section class="section" aria-labelledby="method-preview-heading" id="method">
      <Container>
        <h2 id="method-preview-heading" class="sr-only">Method preview</h2>
        <MethodPreview />
      </Container>
    </section>

    <!-- 6 — Work with me teaser -->
    <section class="section pt-0" aria-labelledby="work-heading" id="work-with-me">
      <Container>
        <h2 id="work-heading" class="sr-only">Work with me</h2>
        <WorkWithMeTeaser />
      </Container>
    </section>

    <!-- Disclosures -->
    <section class="section pt-0" aria-labelledby="disclosures-heading">
      <Container>
        <h2 id="disclosures-heading" class="sr-only">Disclosures</h2>
        <HomeDisclosures />
      </Container>
    </section>
  </main>

  <SiteFooter />
</BaseLayout>

<style>
  table { border-collapse: collapse; }
</style>
