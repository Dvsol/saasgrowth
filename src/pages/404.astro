---
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteHeader from "../components/layout/SiteHeader.astro";
import Container from "../components/shared/Container.astro";
import Button from "../components/shared/Button.astro";
import { siteConfig } from "../lib/site";
---

<BaseLayout title="Page not found — EKIS" description="The page you requested does not exist.">
  <SiteHeader logoText={siteConfig.brand.name} navigationItems={[...siteConfig.nav]} />
  <main id="main" class="section">
    <Container narrow>
      <h1 class="page-title">Page not found</h1>
      <p class="mt-3 supporting">The page you’re looking for doesn’t exist or has moved. Try the scorecards or return home.</p>
      <div class="mt-6 flex gap-3">
        <Button href="/" variant="primary">Go home</Button>
        <Button href="/scorecards" variant="secondary">View scorecards</Button>
      </div>
    </Container>
  </main>
</BaseLayout>
