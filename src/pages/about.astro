---
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteHeader from "../components/layout/SiteHeader.astro";
import Container from "../components/shared/Container.astro";
import { siteConfig } from "../lib/site";
---
<BaseLayout title="About — EKIS" description="Independent SaaS growth publication by EKIS.">
  <SiteHeader logoText={siteConfig.brand.name} navigationItems={[...siteConfig.nav]} activePath="/about" />
  <main id="main" class="section"><Container narrow><h1 class="page-title">About</h1><p class="supporting mt-2">Publisher of practical tests and explainers for SaaS growth software.</p></Container></main>
</BaseLayout>
