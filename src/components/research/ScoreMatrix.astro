---
export interface Props {
  taskDefinitions: string[];
  results?: any[];
  verdicts?: any[];
  testStatus?: string | null;
}
const { taskDefinitions, results, verdicts, testStatus } = Astro.props as Props;
const isPrototype = !results || results.length === 0 || testStatus === "prototype";
---

<section aria-labelledby="scores-heading" class="card overflow-hidden p-0">
  <div class="p-5 border-b flex items-center justify-between" style="border-color: var(--color-border)">
    <h2 id="scores-heading" class="card-title">Scores</h2>
    <span class="chip">{isPrototype ? "Prototype — no scores yet" : "Scores dated"}</span>
  </div>
  {isPrototype ? (
    <div class="p-6">
      <p class="supporting"><strong>Example — not a real test.</strong> Each task is the same sample data, same environment. Scores will appear as dated results with evidence links when published.</p>
      <ul class="mt-3 text-sm text-[var(--color-muted)] list-disc list-inside">
        {taskDefinitions.map(t => <li>{t}</li>)}
      </ul>
    </div>
  ) : (
    <div class="p-6">
      <p class="supporting">Tasks and verdicts — dated, evidenced.</p>
      <ul class="mt-3 space-y-2 text-sm">
        {taskDefinitions.map((t,i) => <li><span class="font-semibold">{t}:</span> {results?.[i] ?? "Pending"} — {verdicts?.[i] ?? "—"}</li>)}
      </ul>
    </div>
  )}
</section>
