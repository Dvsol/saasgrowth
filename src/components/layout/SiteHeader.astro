---
/**
 * SiteHeader — M1 foundation only
 * Props are not hardwired to "EKIS" to allow rebrand (spec 1.)
 */
export interface NavItem { label: string; href: string; }
export interface Props {
  logoText: string;
  navigationItems: NavItem[];
  activePath?: string;
}
const { logoText, navigationItems, activePath = Astro.url.pathname } = Astro.props as Props;

function isActive(href: string, pathname: string) {
  if (href === "/") return pathname === "/";
  return pathname === href || pathname.startsWith(href + "/");
}
---

<header class="sticky top-0 z-40 border-b bg-[var(--color-paper)]/95 backdrop-blur supports-[backdrop-filter]:bg-[var(--color-paper)]/85">
  <div class="container-shell flex h-[64px] items-center justify-between gap-4">
    <a href="/" class="inline-flex min-h-[44px] items-center gap-2.5 shrink-0 rounded-md focus-visible:outline-offset-2" aria-label={`${logoText} — home`}>
      <span aria-hidden="true" class="flex h-9 w-9 items-center justify-center rounded-lg bg-[var(--color-ink)] text-white text-[1.05rem] font-bold">E</span>
      <span class="text-[1.05rem] font-bold tracking-tight text-[var(--color-ink)]">{logoText}</span>
    </a>

    <nav aria-label="Primary" class="hidden items-center gap-1 lg:flex">
      {navigationItems.map((item) => {
        const active = isActive(item.href, activePath);
        return (
          <a
            href={item.href}
            aria-current={active ? "page" : undefined}
            class={`rounded-full px-3 py-2 text-sm font-semibold transition-colors ${active ? "bg-[var(--color-surface)] text-[var(--color-ink)]" : "text-[var(--color-muted)] hover:bg-[var(--color-surface)] hover:text-[var(--color-ink)]"}`}
          >
            {item.label}
          </a>
        );
      })}
    </nav>

    <!-- Mobile -->
    <button
      type="button"
      class="mobile-toggle inline-flex h-11 w-11 items-center justify-center rounded-xl border bg-white text-[var(--color-ink)] lg:hidden"
      aria-expanded="false"
      aria-controls="mobile-nav"
      aria-label="Open menu"
    >
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true">
        <path class="icon-open" d="M4 7h16M4 12h16M4 17h16" />
        <path class="icon-close hidden" d="M6 6l12 12M18 6 6 18" />
      </svg>
    </button>
  </div>

  <!-- Noscript fallback — readable without JS (spec 3.) -->
  <noscript>
    <div class="border-t lg:hidden">
      <nav aria-label="Mobile (noscript)" class="container-shell grid gap-1 py-4">
        {navigationItems.map((item) => (
          <a href={item.href} class="rounded-lg px-3 py-3 text-sm font-semibold text-[var(--color-muted)] hover:bg-[var(--color-surface)] hover:text-[var(--color-ink)]">{item.label}</a>
        ))}
      </nav>
    </div>
  </noscript>

  <!-- JS mobile nav -->
  <div id="mobile-nav" hidden class="border-t bg-[var(--color-paper)] lg:hidden">
    <nav aria-label="Mobile" class="container-shell grid gap-1 py-4">
      {navigationItems.map((item) => {
        const active = isActive(item.href, activePath);
        return (
          <a
            href={item.href}
            aria-current={active ? "page" : undefined}
            class={`rounded-lg px-3 py-3 text-[15px] font-semibold ${active ? "bg-[var(--color-surface)] text-[var(--color-ink)]" : "text-[var(--color-muted)] hover:bg-[var(--color-surface)] hover:text-[var(--color-ink)]"}`}
          >
            {item.label}
          </a>
        );
      })}
      <p class="mt-2 px-3 text-xs leading-relaxed text-[var(--color-muted)]">Independent tests of the tools SaaS founders use to grow.</p>
    </nav>
  </div>
</header>

<script>
  // Lightweight menu — no framework, must be < 1kb gzipped
  (function () {
    const btn = document.querySelector(".mobile-toggle");
    const panel = document.getElementById("mobile-nav");
    if (!btn || !panel) return;
    const openIcon = btn.querySelector(".icon-open");
    const closeIcon = btn.querySelector(".icon-close");
    let open = false;
    const sync = () => {
      btn.setAttribute("aria-expanded", String(open));
      btn.setAttribute("aria-label", open ? "Close menu" : "Open menu");
      // @ts-ignore
      panel.hidden = !open;
      document.body.style.overflow = open ? "hidden" : "";
      openIcon?.classList.toggle("hidden", open);
      closeIcon?.classList.toggle("hidden", !open);
    };
    btn.addEventListener("click", () => { open = !open; sync(); });
    document.addEventListener("keydown", (e) => { if (e.key === "Escape" && open) { open = false; sync(); (btn as HTMLElement).focus(); } });
    const mql = window.matchMedia("(min-width: 1024px)");
    mql.addEventListener("change", (e) => { if (e.matches && open) { open = false; sync(); } });
    // Close on navigation
    panel.addEventListener("click", (e) => { const t = e.target as HTMLElement; if (t.closest("a")) { open = false; sync(); } });
  })();
</script>

<style>
  header { border-color: var(--color-border); }
  .mobile-toggle { border-color: var(--color-border); }
</style>
