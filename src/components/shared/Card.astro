---
export interface Props {
  muted?: boolean;
  padding?: "none" | "sm" | "md" | "lg";
  as?: "div" | "section" | "article" | "a";
  href?: string;
  id?: string;
}
const { muted = false, padding = "md", as: Tag = "div", href, id } = Astro.props;
const pad = padding === "none" ? "p-0" : padding === "sm" ? "p-4" : padding === "lg" ? "p-8" : "p-6";
const base = muted ? "card-muted" : "card";
---

{Tag === "a" ? (
  <a href={href} id={id} class={`${base} ${pad} block focus-visible:outline-offset-2`}>
    <slot />
  </a>
) : (
  <Tag id={id} class={`${base} ${pad}`}>
    <slot />
  </Tag>
)}

<style>
  /* Ensure cards never exceed reading width unless placed in grid */
  :global(.card, .card-muted) {
    overflow: hidden;
  }
</style>
