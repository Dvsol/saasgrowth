---
export interface Props {
  eyebrow?: string;
  title: string;
  description?: string;
  href?: string;
  linkLabel?: string;
  as?: "h2" | "h3";
  id?: string;
}
const { eyebrow, title, description, href, linkLabel, as: Tag = "h2", id } = Astro.props;
---

<div class="max-w-[720px]" id={id}>
  {eyebrow && <p class="eyebrow">{eyebrow}</p>}
  <Tag class="section-title mt-2 text-balance">{title}</Tag>
  {description && <p class="supporting mt-3 max-w-prose">{description}</p>}
  {href && linkLabel && (
    <a href={href} class="link inline-flex items-center gap-1 mt-3 text-sm font-semibold">
      {linkLabel} <span aria-hidden="true">→</span>
    </a>
  )}
</div>
